# /etc/predigol/predigol.env - PrediGol on the server. root:root, chmod 600. NEVER in Git, never in a chat.
# Copy this file there, fill it in, and keep a copy in the owner's password manager.
# Every variable without a default must be set; the stack refuses to start without them.

# ── Site ────────────────────────────────────────────────────────────────────────────────────────────
# The domain the app is served on (its DNS A/AAAA records point at this server). No https://, no slash.
PREDIGOL_DOMAIN=
# Required. Let's Encrypt writes here when a certificate is about to expire and could not be renewed.
PREDIGOL_ACME_EMAIL=
# Where everything that must survive lives: database, RAW, backups, certificates.
PREDIGOL_DATA=/srv/predigol
# The web app's checkout (the frontend repository).
PREDIGOL_WEB_SRC=/opt/predigol/web

# ── Database ────────────────────────────────────────────────────────────────────────────────────────
# A long random password (openssl rand -base64 32). Only the containers use it; no port is published.
POSTGRES_PASSWORD=

# ── API-Football (the worker) ───────────────────────────────────────────────────────────────────────
FBI_APIFOOTBALL_KEY=
# The REAL plan of the account, and our own daily ceiling below its limit.
FBI_APIFOOTBALL_PLAN=ultra
FBI_APIFOOTBALL_DAILY_BUDGET=60000
FBI_APIFOOTBALL_MAX_CONCURRENCY=4

# ── Notices (optional) ──────────────────────────────────────────────────────────────────────────────
# Telegram bot for the app's own notices and for the server monitor (bin/healthcheck.sh).
FBI_TELEGRAM_BOT_TOKEN=
FBI_TELEGRAM_CHAT_ID=
# Healthchecks.io ping URLs (https://hc-ping.com/<uuid>): one per job. Empty = not used.
HC_PING_HEALTH=
HC_PING_BACKUP=
HC_PING_RESTORE_TEST=
HC_PING_RAW_SYNC=

# ── Backups (bin/backup.sh, bin/restore-test.sh, bin/raw-sync.sh) ──────────────────────────────────
# Dumps kept ON THIS SERVER: the newest N, plus the newest of each of the last W weeks.
BACKUP_KEEP_DAILY=3
BACKUP_KEEP_WEEKLY=2
# Copy off the server (recommended): an rclone remote (e.g. "r2:predigol-backups") and the age PUBLIC key
# that encrypts every dump before it leaves (age1...). The private key stays with the owner, never here.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=
# RAW payloads are evidence: copied off the server as they are, never deleted there (rclone copy, no sync).
RAW_RCLONE_REMOTE=
