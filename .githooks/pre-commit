#!/bin/sh
# PrediGol — pre-commit: Gitleaks sobre lo que se va a confirmar (plan de seguridad, R07). Se activa con security/install-git-hooks.sh.
# El valor nunca se imprime. Un hallazgo bloquea el commit; si el escáner no puede correr, avisa y deja pasar (la puerta de cada lanzamiento
# y la CI lo vuelven a mirar). GITLEAKS_REQUIRED=1 hace que bloquee también en ese caso; SKIP_GITLEAKS=1 lo omite a propósito.
if [ "${SKIP_GITLEAKS:-0}" = 1 ]; then
  echo "pre-commit: Gitleaks omitido a propósito (SKIP_GITLEAKS=1)" >&2
  exit 0
fi
ROOT=$(git rev-parse --show-toplevel) || exit 0
# La guarda es la carpeta que contiene este hook (la raíz del repo, o la copia de la guarda del portátil si el clon aún no la tiene)
GUARD=$(cd "$(dirname "$0")/.." 2> /dev/null && pwd) || GUARD=$ROOT
SCAN="$GUARD/security/scan.sh"
[ -f "$SCAN" ] || SCAN="$ROOT/security/scan.sh"
PREDIGOL_GUARD_DIR=${PREDIGOL_GUARD_DIR:-$GUARD} sh "$SCAN" staged
rc=$?
case $rc in
  0) exit 0 ;;
  1)
    cat >&2 << 'MSG'

pre-commit: Gitleaks encontró algo que parece un secreto en lo que vas a confirmar (el valor no se muestra).
  - Si es real: NO lo confirmes. Se revoca primero en el panel del proveedor y después se quita (security/README.md, «Si Gitleaks marca algo»).
  - Si es una constante falsa de una prueba: sigue el patrón de las pruebas (mismo README).
  - Para confirmar a propósito: SKIP_GITLEAKS=1 git commit ...  (la puerta de lanzamiento y la CI lo vuelven a mirar).
MSG
    exit 1
    ;;
  *)
    echo "pre-commit: AVISO - Gitleaks no pudo correr: este commit NO se ha escaneado (security/README.md). GITLEAKS_REQUIRED=1 bloquea en este caso." >&2
    [ "${GITLEAKS_REQUIRED:-0}" = 1 ] && exit 1
    exit 0
    ;;
esac
