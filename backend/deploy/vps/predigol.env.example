# /etc/predigol/predigol.env - the SERVER's settings and secrets. root:root, chmod 600. NEVER in Git, never in a chat.
# Read by the scripts (bin/) and interpolated into docker-compose.yml; never handed whole to an application
# container. The application's own settings are in /etc/predigol/app.env (app.env.example).
# install.sh generates every password and key marked (generated); keep a copy in the owner's password manager.

# ── Site ────────────────────────────────────────────────────────────────────────────────────────────
# The domain the app is served on (its DNS A/AAAA records point at this server). No https://, no slash.
# No domain yet: the server's public IPv4 (203.0.113.10) with PREDIGOL_TLS_MODE=internal.
PREDIGOL_DOMAIN=
# Optional and unused: Let's Encrypt stopped sending expiry e-mails in 2025; the monitor watches the certificate.
PREDIGOL_ACME_EMAIL=
# Where everything that must survive lives: database, RAW, backups, certificates.
PREDIGOL_DATA=/srv/predigol
# The web app's checkout (the frontend repository).
PREDIGOL_WEB_SRC=/opt/predigol/web
# acme (Let's Encrypt, the default) | origin (Cloudflare Origin CA certificate in /etc/predigol/origin/) |
# internal (no domain yet: Caddy's own authority signs for the IP; browsers warn, no PWA - caddy/tls-internal.caddy)
PREDIGOL_TLS_MODE=acme
# Behind Cloudflare: 1 keeps its ranges current every day (bin/cloudflare-ips.sh trust / firewall).
PREDIGOL_CLOUDFLARE=0
# Written by `bin/cloudflare-ips.sh trust`; leave as is.
PREDIGOL_TRUSTED_PROXIES=127.0.0.1/32

# ── Database: one role per job, never a superuser for the application (db/grants.sql) ──────────────
# (generated) the superuser `postgres`: only for the operator inside the container
POSTGRES_ADMIN_PASSWORD=
# (generated) the owner `fbi`: migrations, backups, maintenance
POSTGRES_PASSWORD=
# (generated) the worker `predigol_worker`
POSTGRES_WORKER_PASSWORD=
# (generated) the API `predigol_api`
POSTGRES_API_PASSWORD=
# Memory: defaults suit a 12 GB server (Contabo Cloud VPS 6). For 8 GB: 2GB / 5GB / 4g.
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE_SIZE=7GB
PG_MEM_LIMIT=6g
# CPU caps per container. Docker refuses a cap above the machine's vCPUs: install.sh lowers them to `nproc`
# (a 4-vCPU plan gets 4 / 3 / 2).
PG_CPUS=4
WORKER_CPUS=3
API_CPUS=2

# ── Point-in-time recovery: WAL + base backups, encrypted, to S3-compatible storage (bin/pitr.sh) ───
# Empty bucket = off (only the nightly dumps). Cloudflare R2: endpoint <account id>.r2.cloudflarestorage.com,
# region auto, an API token with Object Read & Write on that bucket only.
PITR_S3_BUCKET=
PITR_S3_ENDPOINT=
PITR_S3_REGION=auto
PITR_S3_KEY=
PITR_S3_KEY_SECRET=
# (generated) encrypts everything in the repository. LOSE IT AND THE PITR BACKUPS ARE UNREADABLE: password manager.
PITR_CIPHER_PASS=
# Full backups kept (one a week): 4 = about a month of point-in-time recovery.
PITR_RETENTION_FULL=4

# ── Backups (bin/backup.sh, bin/restore-test.sh, bin/raw-sync.sh) ──────────────────────────────────
# Dumps kept ON THIS SERVER: the newest N, plus the newest of each of the last W weeks. With an off-server copy
# configured, a dump leaves this server only after its copy there has been checked.
BACKUP_KEEP_DAILY=3
BACKUP_KEEP_WEEKLY=2
# A dump whose off-server copy never reached the bucket is kept as well (it may be the only one) - until a newer dump has been
# copied, and only the newest N of them: a bucket down for weeks must not fill the disk (each dump is ~1.4 GB).
#BACKUP_KEEP_UNVERIFIED=6
# Copy off the server (recommended; bin/r2-setup.sh writes these three): the bucket itself as an rclone remote - exactly
# "r2:<bucket>", no path: the bucket locks are by prefix from its root - and the age PUBLIC key that encrypts every dump
# before it leaves (age1...). The private key stays with the owner, never here.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=
# Off-server retention is the BUCKET'S job (lifecycle rules per prefix: daily 15 days, weekly 57, monthly 396; locks 14 days,
# 8 weeks, 12 months). These only say how long each tier is meant to keep copies: a copy far older raises a warning
# (D+4 days, 7*(W+1)+4 days, 31*(M+1)+4 days), because it would mean a rule is missing. Nothing here deletes anything off the server.
BACKUP_REMOTE_DAYS=14
BACKUP_REMOTE_WEEKS=8
BACKUP_REMOTE_MONTHS=12
# RAW payloads are evidence: copied off the server as they are, never deleted there (rclone copy, no sync).
# "r2:<bucket>/raw": the store's own paths land under raw/ in the bucket.
RAW_RCLONE_REMOTE=
# The hourly pass looks at the day directories of today and yesterday (UTC) only; a full pass runs once every
# RAW_SYNC_FULL_HOURS. The very first pass is a full one: RAW_SYNC_TRANSFERS=16 predigolctl raw-sync --full
#RAW_SYNC_FULL_HOURS=24
#RAW_SYNC_TRANSFERS=4

# ── Alerts to the owner's phone (Telegram) ───────────────────────────────────────────────────────────
# The HOST's own bot, not the application's: bin/lib.sh (notify) uses it first, and no container receives these two. Both or neither - a bot and a chat always
# travel as a pair. Empty = the application's FBI_TELEGRAM_* in app.env is tried next; if that is empty too nothing is sent (the alerts wait and try again on their next run).
PREDIGOL_ALERT_BOT_TOKEN=
PREDIGOL_ALERT_CHAT_ID=

# ── Monitors (optional, free) ────────────────────────────────────────────────────────────────────────
# Healthchecks.io ping URLs (https://hc-ping.com/<uuid>): one per job. Empty = not used.
HC_PING_HEALTH=
HC_PING_BACKUP=
HC_PING_RESTORE_TEST=
HC_PING_RAW_SYNC=
HC_PING_PITR=
HC_PING_PITR_TEST=
HC_PING_MAINT=
