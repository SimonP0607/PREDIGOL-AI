# REHEARSAL ONLY: answers like API-Football (HTTP 200, no errors) with nothing in it.
{
	admin off
	auto_https off
}

:8080 {
	header Content-Type "application/json"
	header x-ratelimit-requests-limit "75000"
	header x-ratelimit-requests-remaining "75000"
	@status path /status
	respond @status `{"get":"status","parameters":[],"errors":[],"results":1,"paging":{"current":1,"total":1},"response":{"account":{"firstname":"rehearsal"},"subscription":{"plan":"Ultra","end":"2099-01-01T00:00:00+00:00","active":true},"requests":{"current":0,"limit_day":75000}}}` 200
	respond `{"get":"stub","parameters":[],"errors":[],"results":0,"paging":{"current":1,"total":1},"response":[]}` 200
}
