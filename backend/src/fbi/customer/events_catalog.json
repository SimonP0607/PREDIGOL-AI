    "news_link_clicked": {"group": "news", "source": "web", "props": {}},
    "notification_enabled": {"group": "notices", "source": "web", "props": {"channel": {"enum": ["email", "push"]}, "category": {"enum": ["account", "security", "membership", "support", "service", "privacy", "legal", "match", "result", "lineup", "digest", "reminder", "device"]}}},
    "notification_opened": {"group": "notices", "source": "web", "props": {"category": {"enum": ["account", "security", "membership", "support", "service", "privacy", "legal", "match", "result", "lineup", "digest", "reminder", "device"]}}},
