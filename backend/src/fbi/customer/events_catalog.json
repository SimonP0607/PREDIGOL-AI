    "favorite_removed": {"group": "entry", "source": "web", "props": {"kind": {"enum": ["team", "competition", "player", "market"]}, "id": {"id": true}, "market": {"enum": ["1X2", "OU", "BTTS", "AH", "DC"]}}},
    "session_started": {"group": "use", "source": "web", "props": {"device": {"enum": ["phone", "tablet", "desktop"]}, "width": {"int": [0, 10000]}, "client": {"enum": ["pwa", "browser"]}, "lang": {"enum": ["es", "en"]}}},
