# ── Base de datos ─────────────────────────────────────────────────────────────
FBI_DATABASE_URL=postgresql+psycopg://fbi:fbi_local_dev@localhost:5433/fbi
POSTGRES_PASSWORD=fbi_local_dev

# ── Proveedor API-Football ────────────────────────────────────────────────────
FBI_APIFOOTBALL_KEY=<COMPLETAR>
FBI_APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Plan: free=10/min·100/dia · pro=300/min·7500/dia · ultra=450/min·75000/dia · mega=900/min·150000/dia
# El plan REAL de tu cuenta, no el que te gustaria. `capture_odds status` lo
# compara con lo que dice el proveedor y avisa si no coinciden: el limite por
# minuto y por dia se derivan de aqui.
FBI_APIFOOTBALL_PLAN=free
# Tope propio, SIEMPRE por debajo del limite del plan (free = 100/dia).
FBI_APIFOOTBALL_DAILY_BUDGET=60
FBI_APIFOOTBALL_MAX_CONCURRENCY=4

# ── Ligas activas ─────────────────────────────────────────────────────────────
# Ya NO se configuran aqui. Fuente unica: config/competitions.yaml, aplicada con
#   python -m scripts.manage_competitions apply

# ── Captura de cuotas ─────────────────────────────────────────────────────────
# Minutos antes del kickoff. /odds se actualiza cada 3h: no tiene sentido bajar de 180.
FBI_ODDS_PREMATCH_WINDOWS=4320,2880,1440,720,360,180
# Ventana near-close via /odds/live (el proveedor la publica entre T-15 y T-5 min)
FBI_ODDS_NEARCLOSE_WINDOW=12
FBI_ODDS_WINDOW_TOLERANCE=45

# ── Capa de decisión IA (fbi.ai; docs/ai/AI_DECISION_LAYER.md) ────────────────
# Sin FBI_AI_MODEL_* la capa usa solo su revisor de reglas (costo cero). Modo: off | shadow | enforce;
# enforce solo filtra lo que ven los usuarios cuando la evaluación shadow de la IA lo aprueba.
FBI_AI_MODE=shadow
# proveedor:modelo por nivel: masivo (extracción de noticias), análisis (revisiones de las próximas 24 h),
# final (las mejores del día). Ej.: anthropic:claude-haiku-5-5 / anthropic:claude-sonnet-5-5 / anthropic:claude-opus-5-5
FBI_AI_MODEL_BULK=
FBI_AI_MODEL_ANALYSIS=
FBI_AI_MODEL_FINAL=
# Claves: nunca a mano en un editor que las muestre; usar scripts/set-secret FBI_AI_KEY_ANTHROPIC (o EXA_API_KEY).
# Topes: un solo presupuesto para toda la IA; al 70 % deja el nivel final, al 90 % solo el barato, al 100 % solo reglas.
FBI_AI_DAILY_BUDGET_USD=1.00
FBI_AI_MONTHLY_BUDGET_USD=20
FBI_AI_MAX_LLM_REVIEWS_PER_DAY=60
FBI_AI_MAX_DEEP_PER_DAY=10

FBI_ENV=local
FBI_LOG_LEVEL=INFO
