#!/usr/bin/env bash
# Store one secret in the backend's .env without it ever being shown: not on screen, not in the shell history,
# not in a process list. The value is typed or pasted at a hidden prompt, checked against the shape it should
# have, and written as NAME=value (an existing NAME line is replaced). The file stays readable by its owner only.
#
#   scripts/set-secret FBI_AI_KEY_ANTHROPIC                # the .env of this repository (host mode)
#   scripts/set-secret EXA_API_KEY /srv/predigol/app.env   # another env file (the VPS)
#
# The AI layer reads .env on every cycle (fbi.core.env): a key stored here is used from the next cycle on,
# without restarting anything. Nothing is printed but the variable's name.
set -euo pipefail

name="${1:-}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
file="${2:-$ROOT/.env}"
if [[ ! "$name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
  echo "uso: scripts/set-secret NOMBRE [ARCHIVO_ENV]   (p. ej. FBI_AI_KEY_ANTHROPIC)"; exit 2
fi

IFS= read -rsp "Pega el valor de $name (no se mostrará) y pulsa Enter: " value
echo
value="${value//[$'\r\n\t ']/}"
if [[ -z "$value" ]]; then echo "Vacío: no se guardó nada."; exit 1; fi
if [[ ! "$value" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then echo "Tiene caracteres inesperados: no se guardó nada."; exit 1; fi
case "$name" in
  FBI_AI_KEY_ANTHROPIC) prefix="sk-ant-" ;;
  FBI_AI_KEY_OPENAI) prefix="sk-" ;;
  *) prefix="" ;;
esac
if [[ -n "$prefix" && "$value" != "$prefix"* ]]; then
  echo "Una clave para $name empieza por $prefix: no se guardó nada."; exit 1
fi

umask 077
touch "$file"
tmp="$(mktemp "$file.XXXXXX")"
grep -v "^${name}=" "$file" > "$tmp" || true
printf '%s=%s\n' "$name" "$value" >> "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$file"
unset value
echo "Listo: $name guardada en $file (solo tu usuario puede leer el archivo; el valor no se mostró)."
